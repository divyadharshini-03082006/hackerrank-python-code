def print_rangoli(size):
    alphabet = "abcdefghijklmnopqrstuvwxyz"
    lines = []
    for i in range(size):
        row_letters = "-".join(alphabet[size-1 : i : -1] + alphabet[i : size])
        lines.append(row_letters.center(4*size-3, '-'))
    result = "\n".join(lines[::-1] + lines[1:])
    print(result)
