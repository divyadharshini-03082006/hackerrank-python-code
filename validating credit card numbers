import re
import sys

def validate_credit_card(card_number: str) -> str:
    structure_pattern = r"^[456]\d{3}(-?\d{4}){3}$"
    
    if not re.match(structure_pattern, card_number):
        return "Invalid"
    clean_number = card_number.replace("-", "")
    repetition_pattern = r"(\d)\1{3,}"
    
    if re.search(repetition_pattern, clean_number):
        return "Invalid"
    
    return "Valid"

if __name__ == "__main__":
    input_data = sys.stdin.read().splitlines()
    
    if input_data:
        n = int(input_data[0].strip())
        for i in range(1, n + 1):
            print(validate_credit_card(input_data[i].strip()))
