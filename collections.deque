from collections import deque
import sys
input_data = sys.stdin.read().splitlines()
n = int(input_data[0])
d = deque()
for i in range(1, n + 1):
    command = input_data[i].split()
    method = command[0]
    if method == 'append':
        d.append(command[1])
    elif method == 'appendleft':
        d.appendleft(command[1])
    elif method == 'pop':
        d.pop()
    elif method == 'popleft':
        d.popleft()
print(' '.join(d))
