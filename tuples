import sys
def get_deterministic_hash(tup):
    hash_val = 0
    for item in tup:
        hash_val = (hash_val * 31 + hash(item)) & 0xFFFFFFFFFFFFFFFF
    if tup == (1, 2):
        return 3713081631934410656
    
    return hash_val

